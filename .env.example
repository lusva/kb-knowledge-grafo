# Copiare in .env per personalizzare questa installazione.
# Il progetto usa data/ e documents/ propri: non puntarli all'app originale.
KB_DEBUG=0
KB_ALLOWED_HOSTS=localhost,127.0.0.1
KB_TIMEZONE=Europe/Rome
KB_PORT=8010

# Motore locale per embeddings, risposte in chat e nomi dei temi.
OLLAMA_URL=http://localhost:11434
KB_CHAT_MODEL=qwen3.5:9b
KB_EMBED_MODEL=nomic-embed-text
KB_EMBED_DIM=768

# Modelli opzionali per immagini e PDF scansionati.
KB_VISION_MODEL=llava
KB_OCR_MODEL=glm-ocr:q8_0

# In alternativa a Ollama: server LLM/embeddings compatibile OpenAI.
# Nessun motore di ricerca internet è incluso.
KB_LLM_URL=
KB_LLM_API_KEY=
KB_EMBED_URL=
KB_EMBED_API_KEY=
KB_LLM_TIMEOUT=300

# Aggiornamento delle cartelle di documenti. 0 = solo manuale.
KB_DOC_AUTO_MINUTES=5
KB_TEMI_AUTO=150
